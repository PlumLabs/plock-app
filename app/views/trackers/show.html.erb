<% content_for :title, "Tracker" %>

<div class="overflow-y-auto h-screen rounded-lg">
  <div class="lg:sticky lg:top-0 z-20 bg-primary-subtle px-4 py-5 sm:px-6 rounded-lg shadow-xs">
    <%= render "tracker/time_entries/form", time_entry: @time_entry %>
  </div>

  <nav class="h-full overflow-y-auto space-y-3 pt-3">
    <% @time_entries_grouped_by_week.each do |week_date, time_entries| %>
      <div class="relative overflow-hidden py-2">
        <div class="relative py-2 px-6">
          <div class="absolute inset-0 flex items-center" aria-hidden="true">
            <div class="w-full "></div>
          </div>
          <div class="relative flex items-center justify-between">
            <div class="flex flex-col sm:flex-row">
              <span class="bg-surface-tint text-sm text-primary-light"><%= week_date.beginning_of_week.to_fs(:long) %></span>
              <span class="bg-surface-tint text-sm text-primary-light hidden sm:block">&nbsp;-&nbsp;</span>
              <span class="bg-surface-tint pr-2 text-sm text-primary-light"><%= week_date.end_of_week.to_fs(:long) %></span>
            </div>
            <span class="bg-surface-tint pl-2 text-sm text-primary-light">
              Total: <%= minutes_to_hours time_entries.sum(&:duration_minutes) %>
            </span>
          </div>
        </div>

        <div class="shadow-xs rounded-lg">
          <% time_entries.group_by(&:date).each do |day_gruop_date, time_entries| %>
            <div class="relative overflow-hidden rounded-md bg-surface px-6 py-2 first:pt-4">
              <div class="relative">
                <div class="absolute inset-0 flex items-center" aria-hidden="true">
                  <div class="w-full border-t text-fg-muted"></div>
                </div>
                <div class="relative flex items-center justify-between">
                  <div class="flex flex-col sm:flex-row">
                    <span class="bg-surface text-sm text-fg-muted font-medium"><%= human_date_format(day_gruop_date) %></span>
                  </div>
                  <span class="bg-surface pl-2 text-sm text-fg-muted font-medium">
                    Total: <%= minutes_to_hours time_entries.sum(&:duration_minutes) %>
                  </span>
                </div>
              </div>

              <ul role="list" class="divide-y divide-border-subtle">
                <% time_entries.each do |time_entry| %>
                  <li class="gap-x-4 px-3 py-5">
                    <%= render "tracker/time_entries/form", time_entry: time_entry %>
                  </li>
                <% end %>
              </ul>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </nav>

  <%= render "pagination/simple", { controller: :trackers, action: :show } %>
</div>

<% if ["created", "destroyed", "updated"].include?(flash[:notice])  %>
  <%= render "alerts/flash", type: :success, title: "Successfully #{flash[:notice]}!", position_class: "fixed top-4 right-4" %>
<% end %>
