<!DOCTYPE html>
<html class="h-full">
  <head>
    <title><%= content_for(:title) || "Design System" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= turbo_refreshes_with method: :morph, scroll: :preserve %>
    <%= yield :head %>

    <link rel="stylesheet" href="https://rsms.me/inter/inter.css">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full bg-surface-tint" data-testid="design-system" data-controller="theme" data-theme-storage-key-value="ds-theme">
    <div>
      <!-- Table of contents -->
      <div class="hidden lg:fixed lg:inset-y-0 lg:z-50 lg:flex lg:w-72 lg:flex-col">
        <div class="flex grow flex-col gap-y-5 overflow-y-auto border-r border-border bg-surface px-6">
          <div class="flex h-16 shrink-0 items-center">
            <h1 class="text-xl font-bold tracking-wide text-fg-default">
              <span class="bg-linear-to-r from-sky-400 to-indigo-600 bg-clip-text text-transparent">PLOCK</span>
              <span class="text-fg-muted">/ Design System</span>
            </h1>
          </div>
          <nav class="flex flex-1 flex-col">
            <ul role="list" class="-mx-2 space-y-1">
              <li class="mb-2 border-b border-border pb-2">
                <%= link_to root_path, class: "group flex gap-x-3 rounded-md p-2 text-sm font-semibold leading-6 text-fg-muted hover:bg-secondary-hover hover:text-primary-light" do %>
                  <svg class="h-6 w-6 shrink-0 text-fg-muted group-hover:text-primary-light" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
                  </svg>
                  Back to Plock
                <% end %>
              </li>
              <% {
                "foundations" => "Foundations",
                "buttons" => "Buttons",
                "badges" => "Badges",
                "forms" => "Forms",
                "alerts" => "Alerts",
                "overlays" => "Overlays",
                "pagination" => "Pagination"
              }.each do |anchor, label| %>
                <li>
                  <a href="#<%= anchor %>" class="group flex gap-x-3 rounded-md p-2 text-sm font-semibold leading-6 text-fg-default hover:bg-secondary-hover hover:text-primary-light">
                    <%= label %>
                  </a>
                </li>
              <% end %>
            </ul>

            <div class="mt-auto pb-4">
              <button
                type="button"
                data-action="theme#toggle"
                class="group flex w-full items-center gap-x-3 rounded-md p-2 text-sm font-semibold leading-6 text-fg-default hover:bg-secondary-hover hover:text-primary-light"
              >
                <svg data-theme-target="lightIcon" class="h-6 w-6 shrink-0 text-fg-muted group-hover:text-primary-light" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />
                </svg>
                <svg data-theme-target="darkIcon" class="hidden h-6 w-6 shrink-0 text-fg-muted group-hover:text-primary-light" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" />
                </svg>
                Toggle theme
              </button>
            </div>
          </nav>
        </div>
      </div>

      <!-- Mobile top bar (the sidebar is hidden below lg) -->
      <div class="sticky top-0 z-40 flex items-center gap-x-4 border-b border-border bg-surface px-4 py-4 shadow-2xs sm:px-6 lg:hidden">
        <%= link_to root_path, class: "flex items-center gap-x-2 text-sm font-semibold text-fg-muted hover:text-primary-light" do %>
          <svg class="h-6 w-6 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
          </svg>
          <span class="sr-only sm:not-sr-only">Back to Plock</span>
        <% end %>
        <div class="flex-1 text-sm font-semibold leading-6 text-fg-default">Design System</div>
        <button
          type="button"
          data-action="theme#toggle"
          class="-m-2.5 p-2.5 text-fg-muted hover:text-primary-light"
        >
          <span class="sr-only">Toggle light/dark theme</span>
          <svg data-theme-target="lightIcon" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />
          </svg>
          <svg data-theme-target="darkIcon" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" />
          </svg>
        </button>
      </div>

      <main class="py-10 lg:pl-72">
        <div class="px-4 sm:px-6 lg:px-8">
          <%= yield %>
        </div>
      </main>
    </div>

    <!-- Global notification live region -->
    <div aria-live="assertive" class="z-50 pointer-events-none fixed inset-0 flex items-end px-4 py-6 sm:items-start sm:p-6">
      <div id="alert-area" class="flex w-full flex-col items-center space-y-4 sm:items-end">
        <%= yield :alert %>
      </div>
    </div>
  </body>
</html>
