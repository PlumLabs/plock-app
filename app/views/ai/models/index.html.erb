<% content_for :title, "Ai::Models" %>

<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-success-subtle mb-5 text-success font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl">Ai::Models</h1>
    <div class="flex items-center gap-2">
      <%= link_to "Ai::Chats", ai_chats_path, class: "rounded-md px-3.5 py-2.5 bg-border-subtle hover:bg-surface-tint text-fg-default block font-medium" %>
      <%= button_to "Refresh Ai::Models", refresh_ai_models_path, method: :post, class: "btn-primary" %>
    </div>
  </div>

  <div id="ai_models" class="mt-5 overflow-x-auto">
    <% if @ai_models.any? %>
      <table class="min-w-full divide-y divide-gray-300 border border-gray-300">
        <thead class="bg-surface-tint">
          <tr>
            <th class="px-3 py-2 text-left text-sm font-semibold text-fg-default">Provider</th>
            <th class="px-3 py-2 text-left text-sm font-semibold text-fg-default">Model</th>
            <th class="px-3 py-2 text-left text-sm font-semibold text-fg-default">Context Window</th>
            <th class="px-3 py-2 text-left text-sm font-semibold text-fg-default">$/1M tokens (In/Out)</th>
            <th class="px-3 py-2 text-left text-sm font-semibold text-fg-default"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 bg-surface">
          <% @ai_models.each do |model_info| %>
            <%= render "ai/models/model",
              model: model_info %>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="text-center my-10">No chat models found.</p>
    <% end %>
  </div>

</div>
