<% content_for :title, "New ai chat" %>

<%= turbo_frame_tag "ai_chats_main" do %>
<div class="flex h-[calc(100vh-7rem)] flex-col lg:h-[calc(100vh-5rem)]">

  <div class="mt-6 flex-1 overflow-y-auto">
    <div id="messages" class="space-y-6 px-2 py-4">
      <!-- empty state -->
      <div class="mx-auto max-w-md sm:max-w-3xl py-8">
        <div class="text-center">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="mx-auto size-12 text-primary">
            <path d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456ZM16.894 20.567 16.5 21.75l-.394-1.183a2.25 2.25 0 0 0-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 0 0 1.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 0 0 1.423 1.423l1.183.394-1.183.394a2.25 2.25 0 0 0-1.423 1.423Z" />
          </svg>
          <h2 class="mt-3 text-base font-semibold text-fg-default">Ask anything about your time-tracking data</h2>
          <p class="mt-1 text-sm text-fg-muted">Pick a suggestion or type your own question below.</p>
        </div>

        <div class="mt-10">
          <h3 class="text-sm font-medium text-fg-muted">Suggested questions</h3>
          <ul role="list" class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
            <% suggested_prompts.each do |prompt| %>
              <li data-controller="clipboard" data-clipboard-text-value="<%= prompt %>">
                <div class="group flex w-full items-center justify-between space-x-3 rounded-full border border-border bg-surface px-4 py-3 text-left shadow-xs hover:bg-surface-tint">
                  <span class="block min-w-0 flex-1 truncate text-sm font-medium text-fg-default">
                    <%= prompt %>
                  </span>
                  <button type="button" data-action="clipboard#copy" aria-label="Copy prompt" class="shrink-0 rounded-full p-1 text-fg-placeholder hover:text-primary focus:outline-2 focus:outline-offset-2 focus:outline-primary">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="size-5">
                      <path d="M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 0 1-1.125-1.125V7.875c0-.621.504-1.125 1.125-1.125H6.75a9.06 9.06 0 0 1 1.5.124m7.5 10.376h3.375c.621 0 1.125-.504 1.125-1.125V11.25c0-4.46-3.243-8.161-7.5-8.876a9.06 9.06 0 0 0-1.5-.124H9.375c-.621 0-1.125.504-1.125 1.125v3.5m7.5 10.375H9.375a1.125 1.125 0 0 1-1.125-1.125v-9.25m12 6.625v-1.875a3.375 3.375 0 0 0-3.375-3.375h-1.5a1.125 1.125 0 0 1-1.125-1.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H9.75" />
                    </svg>
                  </button>
                </div>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
      <!-- end of empty state -->
    </div>
  </div>

  <%= render "form", ai_chat: @ai_chat, turbo_frame: "ai_chats_main" %>
</div>
<% end %>
