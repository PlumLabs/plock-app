<%= turbo_frame_tag "ai_chats_main" do %>
  <div class="mx-auto max-w-md sm:max-w-2xl py-12 px-4">
    <div class="rounded-lg bg-danger-subtle ring-1 ring-danger/20 p-4">
      <div class="flex items-start gap-3">
        <svg class="h-6 w-6 shrink-0 text-danger" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" />
        </svg>
        <div class="min-w-0 flex-1">
          <p class="text-sm font-semibold text-danger-emphasis">Something went wrong</p>
          <p class="mt-1 text-sm text-danger-emphasis wrap-break-word"><%= error %></p>
        </div>
      </div>
    </div>
  </div>
<% end %>
