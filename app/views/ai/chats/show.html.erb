<%= turbo_frame_tag "ai_chats_main" do %>
  <%= turbo_stream_from "ai_chat_#{@ai_chat.id}" %>

  <div class="flex h-[calc(100vh-7rem)] flex-col lg:h-[calc(100vh-5rem)]">
    <div class="flex items-center gap-3 border-b border-border py-2">
      <h3 class="min-w-0 flex-1 truncate text-sm font-semibold text-fg-default">
        <%= @ai_chat.title.presence || "Chat ##{@ai_chat.id}" %>
      </h3>

      <span class="hidden sm:inline-flex items-center rounded-full bg-border-subtle px-2 py-0.5 text-xs text-fg-muted">
        Model: <%= @ai_chat.ai_model&.label || default_model_display_name %>
      </span>

      <details class="relative sm:hidden">
        <summary class="cursor-pointer list-none rounded-md p-1 text-fg-muted hover:bg-border-subtle hover:text-fg-default" aria-label="Chat options">
          <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="size-5">
            <path d="M10 3a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3Zm0 5.5a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3Zm0 5.5a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3Z" />
          </svg>
        </summary>
        <div class="absolute right-0 z-10 mt-2 w-56 rounded-md bg-surface p-3 text-xs text-fg-default shadow-lg ring-1 ring-border">
          <div class="font-medium text-fg-muted">Model</div>
          <div class="mt-1 break-words"><%= @ai_chat.ai_model&.label || default_model_display_name %></div>
        </div>
      </details>
    </div>

    <div class="mt-6 flex-1 overflow-y-auto" data-controller="ai--chat" data-ai--chat-target="aiMessages">
      <div id="ai_messages" class="space-y-6 px-2 py-4">
        <% @ai_chat.ai_messages.for_display.each do |ai_message| %>
          <%= render ai_message %>
        <% end %>

        <div id="ai_errors" class="empty:hidden flex items-start gap-3 rounded-lg bg-danger-subtle ring-1 ring-danger/20 px-4 py-3 text-sm text-danger-emphasis"></div>
        <div id="ai_transient_errors" class="empty:hidden flex items-start gap-3 rounded-lg bg-warning-subtle ring-1 ring-warning/20 px-4 py-3 text-sm text-warning-emphasis"></div>
      </div>
    </div>

    <%= render "ai/messages/form", ai_chat: @ai_chat, ai_message: @ai_message %>
  </div>
<% end %>
