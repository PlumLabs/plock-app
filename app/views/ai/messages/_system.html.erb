<% system ||= local_assigns[:message] %>
<details id="ai_message_<%= system.id %>" class="ml-11 group">
  <summary class="cursor-pointer text-xs text-fg-muted hover:text-fg-default font-mono inline-flex items-center gap-1.5">
    <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="size-3.5">
      <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm.75-11.25a.75.75 0 0 0-1.5 0v3.5a.75.75 0 0 0 1.5 0v-3.5ZM10 15a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" clip-rule="evenodd" />
    </svg>
    <span>System message</span>
    <span class="text-fg-placeholder">·</span>
    <span class="text-fg-placeholder group-open:hidden">show</span>
    <span class="text-fg-placeholder hidden group-open:inline">hide</span>
  </summary>
  <pre class="mt-2 whitespace-pre-wrap overflow-x-auto rounded-md bg-surface-tint ring-1 ring-inset ring-border px-3 py-2 text-xs text-fg-default"><%= system.content.presence || "(empty)" %></pre>
</details>
