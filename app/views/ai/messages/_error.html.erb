<div id="ai_message_<%= message.id %>" class="w-full sm:w-auto my-5 space-y-3 rounded-md px-3 py-2 bg-danger-subtle ring-1 ring-danger/20">
  <div>
    <span class="inline-block rounded px-2 py-0.5 text-xs font-medium bg-danger-hover text-danger-emphasis">
      <%= title.presence || "Error" %>
    </span>
  </div>

  <pre class="whitespace-pre-wrap text-danger-emphasis text-sm overflow-x-auto"><%= error_message %></pre>

  <div>
    <span class="text-sm text-danger-emphasis"><%= message.created_at&.strftime("%I:%M %p") %></span>
  </div>
</div>
