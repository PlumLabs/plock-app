<% assistant ||= local_assigns[:message] %>
<div id="ai_message_<%= assistant.id %>" class="flex gap-3 items-start">
  <div class="shrink-0 flex h-8 w-8 items-center justify-center rounded-full bg-primary text-white text-xs font-semibold">
    A
  </div>
  <div class="min-w-0 flex-1">
    <div class="flex items-baseline gap-2">
      <span class="text-sm font-semibold text-fg-default">Assistant</span>
      <span class="text-xs text-fg-muted"><%= assistant.created_at&.strftime("%I:%M %p") %></span>
    </div>
    <div id="ai_message_<%= assistant.id %>_content" class="mt-1 whitespace-pre-wrap text-sm text-fg-default">
      <% if assistant.content.blank? %>
        <div class="inline-flex items-center gap-1 rounded-md bg-surface-tint px-3">
          <span class="size-2 rounded-full bg-gray-400 animate-bounce [animation-delay:0ms]"></span>
          <span class="size-2 rounded-full bg-gray-400 animate-bounce [animation-delay:150ms]"></span>
          <span class="size-2 rounded-full bg-gray-400 animate-bounce [animation-delay:300ms]"></span>
        </div>
      <% else %>
        <%= assistant.content %>
      <% end %>
      </div>
  </div>
</div>
