<% user ||= local_assigns[:message] %>
<div id="ai_message_<%= user.id %>" class="flex gap-3 items-start">
  <div class="shrink-0 flex h-8 w-8 items-center justify-center rounded-full bg-border text-fg-default text-xs font-semibold">
    U
  </div>
  <div class="min-w-0 flex-1">
    <div class="flex items-baseline gap-2">
      <span class="text-sm font-semibold text-fg-default">You</span>
      <span class="text-xs text-fg-muted"><%= user.created_at&.strftime("%I:%M %p") %></span>
    </div>
    <div id="ai_message_<%= user.id %>_content" class="mt-1 whitespace-pre-wrap text-sm text-fg-default"><%= user.content %></div>
  </div>
</div>
