<div class="mt-4 shrink-0" id="new-message-form">
  <%= form_with(model: ai_message, url: ai_chat_messages_path(ai_chat), id: "new_ai_message", class: "relative") do |form| %>
    <% if ai_message.errors.any? %>
      <div id="error_explanation" class="bg-danger-subtle text-danger px-3 py-2 font-medium rounded-md mt-3">
        <h2><%= pluralize(ai_message.errors.count, "error") %> prohibited this ai message from being saved:</h2>

        <ul class="list-disc ml-6">
          <% ai_message.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="rounded-2xl border border-gray-300 bg-surface shadow-xs focus-within:border-primary-light">
      <%= form.label :content, "Ask a question", class: "sr-only" %>
      <%= form.textarea :content,
                        rows: 2,
                        placeholder: "Ask a question…",
                        required: true,
                        pattern: ".*\\S+.*",
                        title: "Please enter more than just whitespace.",
                        autofocus: true,
                        class: [
                          "block w-full resize-none rounded-2xl border-0 bg-transparent px-4 py-3 text-base text-fg-default placeholder:text-fg-placeholder focus:outline-none focus:ring-0 sm:text-sm/6",
                          {"border-danger focus:outline-danger": ai_message.errors[:content].any?}
                        ] %>


      <div aria-hidden="true" class="py-2">
        <div class="py-px">
          <div class="h-9"></div>
        </div>
      </div>
    </div>

    <div class="absolute inset-x-0 bottom-0 flex justify-end py-2 pr-2 pl-3">
      <div class="shrink-0">
        <%= form.button type: "submit", class: "btn-primary" do %>
          Send Message
          <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="ml-1.5 -mr-0.5 size-4">
            <path d="M3.105 2.289a.75.75 0 0 0-.826.95l1.414 4.925A1.5 1.5 0 0 0 5.135 9.25h6.115a.75.75 0 0 1 0 1.5H5.135a1.5 1.5 0 0 0-1.442 1.086l-1.414 4.926a.75.75 0 0 0 .826.95 28.897 28.897 0 0 0 15.293-7.155.75.75 0 0 0 0-1.114A28.897 28.897 0 0 0 3.105 2.289Z" />
          </svg>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
