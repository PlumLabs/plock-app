<%= form_with(model: project) do |form| %>
  <div class="space-y-12">
    <div class="border-b border-border pb-12">
      <%= render "alerts/error_summary", errors: project.errors.map(&:full_message) if project.errors.present? %>

      <div class="mt-10 grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6">
        <div class="sm:col-span-4">
          <label for="project_name" class="form-label">Name</label>
          <div class="mt-2">
            <%= form.text_field :name, required: true, class: "form-input" %>
          </div>
        </div>

        <div class="sm:col-span-4">
          <label for="project_client_id" class="form-label">Client</label>
          <div class="mt-2">
            <%= form.select :client_id, Client.all.collect { |c| [ c.name, c.id ] }, { include_blank: true }, class: "form-select mt-2 pl-3 pr-10" %>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="mt-6 flex items-center justify-end gap-x-6">
    <%= link_to "Cancel", :back, class: "text-sm/6 font-semibold text-fg-default" %>
    <%= form.submit class: "btn-primary" %>
  </div>
<% end %>
