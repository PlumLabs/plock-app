<% content_for :title, "Project" %>

<div class="">
  <div class="mb-4 flex items-center">
    <div class="flex-auto">
      <h1 class="text-base font-semibold text-gray-900"><%= @project.name %></h1>
    </div>
    <div class="mt-4 ml-16 mt-0 flex-none">
      <%= link_to edit_project_path(@project), class: "inline-flex rounded-full bg-white p-2 text-gray-900 ring-1 ring-inset ring-gray-300 shadow-sm hover:bg-gray-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-600", title: "Edit project" do %>
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true" data-slot="icon" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" />
        </svg>
      <% end %>
    </div>
  </div>

  <div class="mt-4 flow-root">
    <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
      <div class="inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8">
        <div class="overflow-hidden shadow ring-1 ring-black ring-opacity-5 sm:rounded-lg bg-white">

          <span
            data-controller="tabs"
            data-tabs-active-tab-class="text-gray-900"
            data-tabs-active-tab-line-class="bg-indigo-500"
            data-tabs-inactive-tab-class="text-gray-500 hover:text-gray-700"
          >
            <div>
              <div class="sm:hidden">
                <label for="tabs" class="sr-only">Select a tab</label>
                <select id="tabs" name="tabs" class="block w-full rounded-md border-gray-300 focus:border-indigo-500 focus:ring-indigo-500" data-action="tabs#change" data-tabs-target="select">
                  <option selected>Members</option>
                  <option>Status</option>
                  <option>About</option>
                </select>
              </div>

              <div class="hidden sm:block">
                <nav class="isolate flex divide-x divide-gray-200 rounded-lg shadow" aria-label="Tabs">
                  <a href="#" data-tabs-target="tab" data-action="click->tabs#change:prevent" class="group relative min-w-0 flex-1 overflow-hidden rounded-l-lg bg-white px-4 py-4 text-center text-sm font-medium hover:bg-gray-50 focus:z-10" aria-current="page">
                    <span>Members</span>
                    <span aria-hidden="true" class="absolute inset-x-0 bottom-0 h-0.5"></span>
                  </a>

                  <a href="#" data-tabs-target="tab" data-action="click->tabs#change:prevent" class="group relative min-w-0 flex-1 overflow-hidden bg-white px-4 py-4 text-center text-sm font-medium text-gray-500 hover:bg-gray-50 hover:text-gray-700 focus:z-10">
                    <span>Status</span>
                    <span aria-hidden="true" class="absolute inset-x-0 bottom-0 h-0.5"></span>
                  </a>

                  <a href="#" data-tabs-target="tab" data-action="click->tabs#change:prevent" class="group relative min-w-0 flex-1 overflow-hidden bg-white px-4 py-4 text-center text-sm font-medium text-gray-500 hover:bg-gray-50 hover:text-gray-700 focus:z-10">
                    <span>About</span>
                    <span aria-hidden="true" class="absolute inset-x-0 bottom-0 h-0.5"></span>
                  </a>
                </nav>
              </div>
            </div>

            <div class="hidden py-4 px-4 border-l border-b border-r" data-tabs-target="panel">
              <%# Member start %>

  <div class="">
  <div class="mb-4 flex items-center">
    <div class="flex-auto"></div>
    <div class="mt-4 ml-16 mt-0 flex-none">
      <%= link_to edit_project_path(@project), class: "inline-flex rounded-full bg-indigo-600 p-2 text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600", title: "Edit project" do %>
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M18 7.5v3m0 0v3m0-3h3m-3 0h-3m-2.25-4.125a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0ZM3 19.235v-.11a6.375 6.375 0 0 1 12.75 0v.109A12.318 12.318 0 0 1 9.374 21c-2.331 0-4.512-.645-6.374-1.766Z" />
        </svg>
      <% end %>
    </div>
  </div>

  <div class="mt-4 flow-root">
    <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
      <div class="inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8">
        <div class="overflow-hidden ring-1 ring-black ring-opacity-5 sm:rounded-lg bg-white">

          <!-- Table Container -->
            <div role="table" class="w-full">

              <!-- Header Row -->
              <div role="row" class="hidden sm:grid grid-cols-1 sm:grid-cols-3 font-bold py-2 w-full">
                <div role="columnheader" class="pl-4 pr-3 py-3.5 text-sm text-left font-semibold text-gray-900 sm:pl-6">Name</div>
                <div role="columnheader" class="pl-4 pr-3 py-3.5 text-sm text-left font-semibold text-gray-900 sm:pl-6">Role</div>
                <div role="columnheader" class="pl-4 pr-3 py-3.5 text-sm text-left font-semibold text-gray-900 sm:pl-6 sm:text-right"></div>
              </div>

              <!-- Data Rows -->
              <ul role="rowgroup" class="space-y-2">
                <% @project.project_assignments.each do |assignment| %>
                  <li role="row" class="grid grid-cols-1 sm:grid-cols-3 items-start bg-white p-2 border-b" data-test-id=<%= assignment.id %> >

                    <div role="cell">
                      <span class="sm:hidden font-bold">Name: </span>
                      <span class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-gray-900 sm:pl-6"><%= assignment.user_name %></span>
                    </div>

                    <div role="cell">
                      <span class="sm:hidden font-bold">Role: </span>
                      <% color_klass = assignment.manager? ? "bg-indigo-50 text-indigo-700 ring-indigo-700/10" : "bg-gray-50 text-gray-600 ring-gray-500/10" %>
                      <span class="inline-flex items-center rounded-md px-2 py-1 text-xs font-medium ring-1 ring-inset <%= color_klass %>">
                        <%= assignment.role.capitalize %>
                      </span>
                    </div>

                    <div role="cell" class="flex space-x-2 sm:justify-end">
                      <span class="sm:hidden font-bold">Actions: </span>
                      <%= link_to edit_user_profile_path(assignment.user), class: "hover:text-indigo-600 pr-4", data: { turbo_frame: "_top" }, title: "Edit" do %>
                          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" stroke="currentColor" aria-hidden="true" data-slot="icon">
                            <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L6.832 19.82a4.5 4.5 0 0 1-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 0 1 1.13-1.897L16.863 4.487Zm0 0L19.5 7.125" />
                          </svg>
                      <% end %>
                      <%= link_to "#",
                                    method: :delete,
                                    class: "hover:text-red-600 pr-4",
                                    data: {
                                      turbo_frame: "_top",
                                      turbo_method: :delete,
                                      turbo_confirm: "Do you want to archive?"
                                    },
                                    title: "Archive" do %>
                          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21a47.872 47.872 0 0 0 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a47.872 47.872 0 0 0-3.478-.397m-12 .562a47.872 47.872 0 0 1 1.022-.165m0 0a47.872 47.872 0 0 1 3.478-.397m7.5 0V4.75c0-1.18-.91-2.164-2.09-2.201a49.848 49.848 0 0 0-3.32 0C9.91 2.586 9 3.571 9 4.75v.916m7.5 0a47.872 47.872 0 0 0-7.5 0" />
                          </svg>
                        <% end %>
                    </div>
                  </li>
                <% end %>
              </ul>
            </div>

        </div>
      </div>
    </div>
  </div>
</div>





              <%# Member end %>
            </div>

            <div class="hidden py-4 px-4 border-l border-b border-r" data-tabs-target="panel">
              Tab panel 2
            </div>

            <div class="hidden py-4 px-4 border-l border-b border-r" data-tabs-target="panel">
              <%= render @project %>
            </div>

          </span>
        </div>
      </div>
    </div>
  </div>
</div>

<% if flash[:notice] == "created" %>
  <%= render "alerts/success", title: "Successfully created!" %>
<% end %>

<% if flash[:notice] == "destroyed" %>
  <%= render "alerts/success", title: "Successfully deleted!" %>
<% end %>
