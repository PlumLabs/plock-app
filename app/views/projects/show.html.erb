<% content_for :title, "Project" %>

<div class="">
  <div class="mb-4 flex items-center">
    <div class="flex-auto">
      <h1 class="text-base font-semibold text-fg-default"><%= @project.name %></h1>
    </div>
    <div class="mt-4 ml-16 mt-0 flex-none">
      <%= link_to edit_project_path(@project), class: "btn-icon-secondary", title: "Edit project", aria: { label: "Edit project" } do %>
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true" data-slot="icon" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" />
        </svg>
      <% end %>
    </div>
  </div>

  <div class="mt-4 flow-root">
    <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
      <div class="inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8">
        <div class="overflow-hidden shadow-xs ring-1 ring-border-subtle sm:rounded-lg bg-surface">
          <span
            data-controller="tabs"
            data-tabs-active-tab-class="text-fg-default"
            data-tabs-active-tab-line-class="bg-primary-light"
            data-tabs-inactive-tab-class="text-fg-muted hover:text-fg-default"
            data-tabs-update-anchor-value="true"
          >
            <%# Tabs %>
            <div>
              <div class="sm:hidden">
                <label for="tabs" class="sr-only">Select a tab</label>
                <select id="tabs" name="tabs" class="form-select" data-action="tabs#change" data-tabs-target="select">
                  <option selected>Members</option>
                  <option>Status</option>
                  <option>About</option>
                </select>
              </div>

              <div class="hidden sm:block">
                <nav class="isolate flex divide-x divide-border rounded-lg shadow-xs" aria-label="Tabs">
                  <a id="members" href="#" data-tabs-target="tab" data-action="click->tabs#change:prevent" class="group relative min-w-0 flex-1 overflow-hidden rounded-l-lg bg-surface px-4 py-4 text-center text-sm font-medium hover:bg-surface-tint focus:z-10" aria-current="page">
                    <span>Members</span>
                    <span aria-hidden="true" class="absolute inset-x-0 bottom-0 h-0.5"></span>
                  </a>

                  <a id="status" href="#" data-tabs-target="tab" data-action="click->tabs#change:prevent" class="group relative min-w-0 flex-1 overflow-hidden bg-surface px-4 py-4 text-center text-sm font-medium text-fg-muted hover:bg-surface-tint hover:text-fg-default focus:z-10">
                    <span>Status</span>
                    <span aria-hidden="true" class="absolute inset-x-0 bottom-0 h-0.5"></span>
                  </a>

                  <a id="about" href="#" data-tabs-target="tab" data-action="click->tabs#change:prevent" class="group relative min-w-0 flex-1 overflow-hidden bg-surface px-4 py-4 text-center text-sm font-medium text-fg-muted hover:bg-surface-tint hover:text-fg-default focus:z-10">
                    <span>About</span>
                    <span aria-hidden="true" class="absolute inset-x-0 bottom-0 h-0.5"></span>
                  </a>
                </nav>
              </div>
            </div>
            <%# End tabs %>

            <%# panels %>
            <div class="hidden py-4 px-4 border-l border-b border-r border-border" data-tabs-target="panel">
              <%= render "membership", project: @project %>
            </div>

            <div class="hidden py-4 px-4 border-l border-b border-r border-border" data-tabs-target="panel">
              <%= render "status",
                         project: @project,
                         top_contributors: @top_contributors,
                         all_contributions: @all_contributions %>
            </div>

            <div class="hidden py-4 px-4 border-l border-b border-r border-border" data-tabs-target="panel">
              <%= render @project %>
            </div>

          </span>
        </div>
      </div>
    </div>
  </div>
</div>

<% if ["destroyed", "created", "updated"].include?(flash[:notice])  %>
  <% content_for :alert do %>
    <%= render "alerts/flash", type: :success, title: "Successfully #{flash[:notice]}!" %>
  <% end %>
<% end %>

<%= turbo_frame_tag "upsert_member" %>
