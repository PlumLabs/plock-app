<% content_for :title, "Project" %>

<div class="">
  <div class="mb-4 flex items-center">
    <div class="flex-auto">
      <h1 class="text-base font-semibold text-gray-900"><%= @project.name %></h1>
    </div>
    <div class="mt-4 ml-16 mt-0 flex-none">
      <%= link_to edit_project_path(@project), class: "inline-flex rounded-full bg-white p-2 text-gray-900 ring-1 ring-inset ring-gray-300 shadow-xs hover:bg-gray-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-600", title: "Edit project" do %>
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true" data-slot="icon" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" />
        </svg>
      <% end %>
    </div>
  </div>

  <div class="mt-4 flow-root">
    <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
      <div class="inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8">
        <div class="overflow-hidden shadow-sm ring-1 ring-black ring-opacity-5 sm:rounded-lg bg-white">
          <span
            data-controller="tabs"
            data-tabs-active-tab-class="text-gray-900"
            data-tabs-active-tab-line-class="bg-indigo-500"
            data-tabs-inactive-tab-class="text-gray-500 hover:text-gray-700"
            data-tabs-update-anchor-value="true"
          >
            <%# Tabs %>
            <div>
              <div class="sm:hidden">
                <label for="tabs" class="sr-only">Select a tab</label>
                <select id="tabs" name="tabs" class="block w-full rounded-md border-gray-300 focus:border-indigo-500 focus:ring-indigo-500" data-action="tabs#change" data-tabs-target="select">
                  <option selected>Members</option>
                  <option>Status</option>
                  <option>About</option>
                </select>
              </div>

              <div class="hidden sm:block">
                <nav class="isolate flex divide-x divide-gray-200 rounded-lg shadow-sm" aria-label="Tabs">
                  <a id="members" href="#" data-tabs-target="tab" data-action="click->tabs#change:prevent" class="group relative min-w-0 flex-1 overflow-hidden rounded-l-lg bg-white px-4 py-4 text-center text-sm font-medium hover:bg-gray-50 focus:z-10" aria-current="page">
                    <span>Members</span>
                    <span aria-hidden="true" class="absolute inset-x-0 bottom-0 h-0.5"></span>
                  </a>

                  <a id="status" href="#" data-tabs-target="tab" data-action="click->tabs#change:prevent" class="group relative min-w-0 flex-1 overflow-hidden bg-white px-4 py-4 text-center text-sm font-medium text-gray-500 hover:bg-gray-50 hover:text-gray-700 focus:z-10">
                    <span>Status</span>
                    <span aria-hidden="true" class="absolute inset-x-0 bottom-0 h-0.5"></span>
                  </a>

                  <a id="about" href="#" data-tabs-target="tab" data-action="click->tabs#change:prevent" class="group relative min-w-0 flex-1 overflow-hidden bg-white px-4 py-4 text-center text-sm font-medium text-gray-500 hover:bg-gray-50 hover:text-gray-700 focus:z-10">
                    <span>About</span>
                    <span aria-hidden="true" class="absolute inset-x-0 bottom-0 h-0.5"></span>
                  </a>
                </nav>
              </div>
            </div>
            <%# End tabs %>

            <%# panels %>
            <div class="hidden py-4 px-4 border-l border-b border-r" data-tabs-target="panel">
              <%= render "membership", project: @project %>
            </div>

            <div class="hidden py-4 px-4 border-l border-b border-r" data-tabs-target="panel">
              <button type="button" class="relative block w-full rounded-lg border-2 border-dashed border-gray-300 p-12 text-center hover:border-gray-400 focus:outline-hidden focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2">
                <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 mx-auto size-12 text-gray-400">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456ZM16.894 20.567 16.5 21.75l-.394-1.183a2.25 2.25 0 0 0-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 0 0 1.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 0 0 1.423 1.423l1.183.394-1.183.394a2.25 2.25 0 0 0-1.423 1.423Z" />
                </svg>
                <span class="mt-2 block text-sm font-semibold text-gray-900">Coming Soon</span>
              </button>
            </div>

            <div class="hidden py-4 px-4 border-l border-b border-r" data-tabs-target="panel">
              <%= render @project %>
            </div>

          </span>
        </div>
      </div>
    </div>
  </div>
</div>

<% if ["destroyed", "created", "updated"].include?(flash[:notice])  %>
  <% content_for :alert do %>
    <%= render "alerts/success", title: "Successfully #{flash[:notice]}!" %>
  <% end %>
<% end %>

<%= turbo_frame_tag "upsert_member" %>
