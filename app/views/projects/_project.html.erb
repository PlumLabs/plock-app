<div id="<%= dom_id project %>">
  <div class="mt-6 border-border-subtle">
    <dl class="divide-y divide-border-subtle">
      <div class="px-4 py-6 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-0">
        <dt class="text-sm/6 font-medium text-fg-default">Name</dt>
        <dd class="mt-1 text-sm/6 text-fg-default sm:col-span-2 sm:mt-0"><%= project.name %></dd>
      </div>
      <div class="px-4 py-6 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-0">
        <dt class="text-sm/6 font-medium text-fg-default">Client</dt>
        <dd class="mt-1 text-sm/6 text-fg-default sm:col-span-2 sm:mt-0">
          <% if project.client %>
            <%= project.client.name %>
          <% else %>
            <%= link_to "Assign client", edit_project_path(project), class: "font-medium text-primary hover:text-primary-light" %>
          <% end %>
        </dd>
      </div>
      <div class="px-4 py-6 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-0">
        <dt class="text-sm/6 font-medium text-fg-default">Client email address</dt>
        <dd class="mt-1 text-sm/6 text-fg-default sm:col-span-2 sm:mt-0">
          <% if project.client %>
            <%= project.client.email %>
          <% else %>
            <%= link_to "Assign client", edit_project_path(project), class: "font-medium text-primary hover:text-primary-light" %>
          <% end %>
        </dd>
      </div>
      <div class="px-4 py-6 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-0">
        <dt class="text-sm/6 font-medium text-fg-default">Created at</dt>
        <dd class="mt-1 text-sm/6 text-fg-default sm:col-span-2 sm:mt-0"><%= time_ago_in_words(project.created_at) %> ago</dd>
      </div>
    </dl>
  </div>
</div>
