<%= form_with(model: [project, project_assignment], data: { turbo_frame: "_top" }) do |form| %>
  <div class="space-y-12">
    <div class="border-b border-border pb-12">
      <div class="mt-10 grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6">
        <div class="sm:col-span-4">
          <p class="form-label">Name</p>
          <div class="mt-2">
            <%= project_assignment.user_name %>
          </div>
        </div>

        <div class="sm:col-span-4">
          <p for="user_last_name" class="form-label">Email</p>
          <div class="mt-2">
            <%= project_assignment.user_email_address %>
          </div>
        </div>
      </div>
    </div>

    <div class="border-b border-border pb-12">
      <p class="mt-1 text-sm/6 text-fg-muted">⚠️ Manager role can do everything</p>

      <div class="mt-10 grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6">
        <div class="sm:col-span-3">
          <%= form.label :role, class: "form-label" %>
          <div class="mt-2">
            <%= form.select :role, ProjectAssignment.roles.keys.map { |role| [role.titleize, role] }, {}, class: "form-select sm:max-w-xs" %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="mt-6 flex items-center justify-end gap-x-6">
    <%= link_to "Cancel", :back, class: "text-sm/6 font-semibold text-fg-default" %>
    <%= form.submit class: "btn-primary" %>
  </div>
<% end %>
