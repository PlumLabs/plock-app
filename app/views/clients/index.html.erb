<% content_for :title, "Clients" %>

<div class="px-4 sm:px-6 lg:px-8">

  <div class="mb-4 flex items-center">
    <div class="flex-auto">
      <h1 class="text-base font-semibold text-gray-900">Clients</h1>
    </div>
    <div class="mt-4 ml-16 mt-0 flex-none">
      <%= link_to new_client_path, class: "inline-flex rounded-full bg-indigo-600 p-2 text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600" do %>
        <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon">
          <path d="M10.75 4.75a.75.75 0 0 0-1.5 0v4.5h-4.5a.75.75 0 0 0 0 1.5h4.5v4.5a.75.75 0 0 0 1.5 0v-4.5h4.5a.75.75 0 0 0 0-1.5h-4.5v-4.5Z" />
        </svg>
      <% end %>
    </div>
  </div>

  <div class="mt-4 flow-root">
    <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
      <div class="inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8">
        <div class="overflow-hidden shadow ring-1 ring-black ring-opacity-5 sm:rounded-lg bg-white">
          <div class="px-4 py-5 sm:px-6">
            <%= form_with url: clients_path, method: :get, data: { controller: "auto-submit", auto_submit_debounce_value: 300, turbo_frame: "clients", turbo_action: "advance" }, class: "relative mt-2 rounded-md shadow-sm" do |form| %>
              <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
                <svg class="h-5 w-5 text-gray-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon">
                  <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11ZM2 9a7 7 0 1 1 12.452 4.391l3.328 3.329a.75.75 0 1 1-1.06 1.06l-3.329-3.328A7 7 0 0 1 2 9Z" clip-rule="evenodd" />
                </svg>
              </div>
              <%= form.search_field(
                "q[name_or_email_cont]",
                data: { action: "input->auto-submit#submit" },
                class: "block w-full rounded-md border-0 py-1.5 pl-10 text-gray-900 ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm/6",
                placeholder: "Search Clients"
              ) %>
            <% end %>
          </div>


          <%= turbo_frame_tag "clients" do %>
            <!-- Table Container -->
            <div role="table" class="w-full">

              <!-- Header Row -->
              <div role="row" class="hidden sm:grid grid-cols-1 sm:grid-cols-4 font-bold py-2 w-full">
                <div role="columnheader" class="pl-4 pr-3 py-3.5 text-sm text-left font-semibold text-gray-900 sm:pl-6">Name</div>
                <div role="columnheader" class="pl-4 pr-3 py-3.5 text-sm text-left font-semibold text-gray-900 sm:pl-6">Email</div>
                <div role="columnheader" class="pl-4 pr-3 py-3.5 text-sm text-left font-semibold text-gray-900 sm:pl-6">Note</div>
                <div role="columnheader" class="pl-4 pr-3 py-3.5 text-sm text-left font-semibold text-gray-900 sm:pl-6 sm:text-right">Actions</div>
              </div>

              <!-- Data Rows -->
              <ul role="rowgroup" class="space-y-2">
                <% @clients.each do |client| %>
                  <li role="row" class="grid grid-cols-1 sm:grid-cols-4 items-start bg-white p-2 rounded shadow" data-test-id=<%= client.id %>>
                    <div role="cell">
                      <span class="sm:hidden font-bold">Name: </span>
                      <span class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-gray-900 sm:pl-6"><%= client.name %></span>
                    </div>
                    <div role="cell">
                      <span class="sm:hidden font-bold">Email: </span>
                      <span class="whitespace-nowrap px-3 py-4 text-sm text-gray-500"><%= client.email %></span>
                    </div>
                    <div role="cell">
                      <span class="sm:hidden font-bold">Note: </span>
                      <span
                        class="whitespace-nowrap px-3 py-4 text-sm text-gray-500"
                        title="<%= client.note %>"
                      >
                        <%= truncate(client.note, length: 55) %>
                      </span>
                    </div>
                    <div role="cell" class="flex space-x-2 sm:justify-end">
                      <span class="sm:hidden font-bold">Actions: </span>
                      <%= link_to "Edit", edit_client_path(client), class: "text-indigo-600 hover:text-indigo-900", data: { turbo_frame: "_top" } %>
                    </div>
                  </li>
                <% end %>
              </ul>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<% if flash[:notice] == "created" %>
  <%= render "alerts/success", title: "Successfully created!" %>
<% end %>

<% if flash[:notice] == "updated" %>
  <%= render "alerts/success", title: "Successfully updated!" %>
<% end %>
