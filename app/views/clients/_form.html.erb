<%= form_with(model: client) do |form| %>
  <div class="space-y-12">
    <div class="border-b border-border pb-12">
      <%= render "alerts/error_summary", errors: client.errors.map(&:full_message) if client.errors.present? %>

      <div class="mt-10 grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6">
        <div class="sm:col-span-4">
          <label for="client_name" class="form-label">Name</label>
          <div class="mt-2">
            <%= form.text_field :name, required: true, class: "form-input" %>
          </div>
        </div>

        <div class="sm:col-span-4">
          <label for="client_email" class="form-label">Email address</label>
          <div class="mt-2">
            <%= form.email_field :email, class: "form-input" %>
          </div>
        </div>

        <div class="sm:col-span-4">
          <label for="client_note" class="form-label">Note</label>
          <div class="mt-2">
            <%= form.textarea :note, rows: 4, class: "form-input" %>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="mt-6 flex items-center justify-end gap-x-6">
    <%= link_to "Cancel", clients_path, class: "text-sm/6 font-semibold text-fg-default" %>
    <%= form.submit class: "btn-primary" %>
  </div>
<% end %>
