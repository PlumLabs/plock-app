<div class="space-y-10 divide-y divide-border">
  <div class="grid grid-cols-1 gap-x-8 gap-y-8 md:grid-cols-3">
    <div class="px-4 sm:px-0">
      <h2 class="text-base/7 font-semibold text-fg-default">Personal Information</h2>
      <p class="mt-1 text-sm/6 text-fg-muted">Use a permanent address where you can receive mail.</p>
    </div>

    <%= turbo_frame_tag @user, :profile, class: "bg-surface shadow-2xs ring-1 ring-border-subtle sm:rounded-xl md:col-span-2" do %>
      <%= form_with url: user_profile_path(@user), model: @user, method: :put do |form| %>
        <%= render "alerts/error_summary", errors: @user.errors.map(&:full_message) if @user.errors.present? %>
        <div class="px-4 py-6 sm:p-8">
          <div class="grid max-w-2xl grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6">
            <div class="sm:col-span-3">
              <label for="first_name" class="form-label">First name</label>
              <div class="mt-2">
                <%= form.text_field :first_name, autocomplete: "given-name", class: "form-input" %>
              </div>
            </div>

            <div class="sm:col-span-3">
              <label for="last_name" class="form-label">Last name</label>
              <div class="mt-2">
                <%= form.text_field :last_name, autocomplete: "family-name", class: "form-input" %>
              </div>
            </div>

            <div class="sm:col-span-4">
              <label for="email_address" class="form-label">Email address</label>
              <div class="mt-2">
                <%= form.email_field :email_address, autocomplete: "email", disabled: !Current.user.can_administrate?, class: "form-input" %>
                <% if !Current.user.can_administrate? %>
                  <p class="mt-2 text-sm text-fg-muted">Only Administrator can update this.</p>
                <% end %>
              </div>
            </div>
          </div>
        </div>
        <div class="flex items-center justify-end gap-x-6 border-t border-border px-4 py-4 sm:px-8">
          <% if flash[:notice] %>
            <div data-controller="flash" class="rounded-md">
              <div class="flex">
                <div class="shrink-0">
                  <svg class="h-5 w-5 text-success" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.857-9.809a.75.75 0 0 0-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z" clip-rule="evenodd" />
                  </svg>
                </div>
                <div class="ml-3">
                  <p class="text-sm font-medium text-success-emphasis">Successfully uploaded</p>
                </div>
              </div>
            </div>
          <% end %>
          <%= link_to "Cancel", request.referer, class: "text-sm/6 font-semibold text-fg-default", data: { turbo_frame: "_top" } %>
          <button type="submit" class="btn-primary">Save</button>
        </div>
      <% end %>
    <% end %>
  </div>

  <div class="grid grid-cols-1 gap-x-8 gap-y-8 pt-10 md:grid-cols-3">
    <div class="px-4 sm:px-0">
      <h2 class="text-base/7 font-semibold text-fg-default">Change password</h2>
      <p class="mt-1 text-sm/6 text-fg-muted">Update your password associated with your account.</p>
    </div>

    <%= turbo_frame_tag @user, :password, class: "bg-surface shadow-2xs ring-1 ring-border-subtle sm:rounded-xl md:col-span-2" do %>
      <%= form_with url: user_profile_path(@user), model: @user, method: :put do |form| %>
        <%= render "alerts/error_summary", errors: @user.errors.map(&:full_message) if @user.errors.present? %>

        <div class="px-4 py-6 sm:p-8">
          <div class="grid max-w-2xl grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6">
            <div class="sm:col-span-4">
              <label for="password" class="form-label">New Password</label>
              <div class="mt-2">
                <%= form.password_field :password, required: true, autocomplete: "new-password", placeholder: "Enter new password", maxlength: 72, class: "form-input" %>
              </div>
            </div>

            <div class="sm:col-span-4">
              <label for="password_confirmation" class="form-label">Repeat new password</label>
              <div class="mt-2">
                <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", placeholder: "Repeat new password", maxlength: 72, class: "form-input" %>
              </div>
            </div>
          </div>
        </div>
        <div class="flex items-center justify-end gap-x-6 border-t border-border px-4 py-4 sm:px-8">
          <% if flash[:notice] %>
            <div data-controller="flash" class="rounded-md">
              <div class="flex">
                <div class="shrink-0">
                  <svg class="h-5 w-5 text-success" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.857-9.809a.75.75 0 0 0-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z" clip-rule="evenodd" />
                  </svg>
                </div>
                <div class="ml-3">
                  <p class="text-sm font-medium text-success-emphasis">Successfully uploaded</p>
                </div>
              </div>
            </div>
          <% end %>
          <%= link_to "Cancel", request.referer, class: "text-sm/6 font-semibold text-fg-default", data: { turbo_frame: "_top" } %>
          <%= form.submit "Save", class: "btn-primary" %>
        </div>
      <% end %>
    <% end %>
  </div>

  <% if Current.user.can_administrate? %>
    <div class="grid grid-cols-1 gap-x-8 gap-y-8 pt-10 md:grid-cols-3">
      <div class="px-4 sm:px-0">
        <h2 class="text-base/7 font-semibold text-fg-default">Change Role</h2>
        <p class="mt-1 text-sm/6 text-fg-muted">Administrator role can access everything</p>
      </div>

      <% if @user.current? %>
        <p class="text-fg-muted">Administrators cannot change their own role.</p>
      <% else %>
        <%= turbo_frame_tag @user, :role, class: "bg-surface shadow-2xs ring-1 ring-border-subtle sm:rounded-xl md:col-span-2" do %>
          <%= form_with url: user_profile_path(@user), model: @user, method: :put do |form| %>
            <%= render "alerts/error_summary", errors: @user.errors.map(&:full_message) if @user.errors.present? %>

            <div class="px-4 py-6 sm:p-8">
              <div class="grid max-w-2xl grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6">
                <div class="sm:col-span-4">
                  <%= form.label :role, class: "form-label" %>
                  <div class="mt-2">
                    <%= form.select :role, User.roles.keys.map { |role| [role.titleize, role] }, {}, class: "form-select sm:max-w-xs" %>
                  </div>
                </div>
              </div>
            </div>
            <div class="flex items-center justify-end gap-x-6 border-t border-border px-4 py-4 sm:px-8">
              <% if flash[:notice] %>
                <div data-controller="flash" class="rounded-md">
                  <div class="flex">
                    <div class="shrink-0">
                      <svg class="h-5 w-5 text-success" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.857-9.809a.75.75 0 0 0-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z" clip-rule="evenodd" />
                      </svg>
                    </div>
                    <div class="ml-3">
                      <p class="text-sm font-medium text-success-emphasis">Successfully uploaded</p>
                    </div>
                  </div>
                </div>
              <% end %>
              <%= link_to "Cancel", request.referer, class: "text-sm/6 font-semibold text-fg-default", data: { turbo_frame: "_top" } %>
              <%= form.submit "Save", data: { turbo_confirm: "Are you sure?" }, class: "btn-primary" %>
            </div>
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <% if Current.user.can_administrate? %>
    <%= turbo_frame_tag @user, :deactivate, class: "grid grid-cols-1 gap-x-8 gap-y-8 pt-10 md:grid-cols-3" do %>
      <div class="px-4 sm:px-0">
        <% if @user.active? %>
          <h2 class="text-base/7 font-semibold text-fg-default">Deactivate User Account</h2>
          <p class="mt-1 text-sm/6 text-fg-muted">The user will no longer be able to log in.</p>
        <% else %>
          <h2 class="text-base/7 font-semibold text-fg-default">Reactivate User Account</h2>
          <p class="mt-1 text-sm/6 text-fg-muted">The user will be able to log in.</p>
        <% end %>
      </div>

      <div class="flex items-start md:col-span-2">
        <% if @user.current? %>
          <p class="text-fg-muted">Administrators cannot Deactivate/Reactivate their own account.</p>
        <% elsif @user.active? %>
          <%= button_to(
            user_profile_path(@user),
            method: :delete,
            data: { turbo_confirm: "Are you sure?" },
            class: "btn-danger") do %>
            <span>Yes, Deactivate the account</span>
          <% end %>
        <% else %>
          <%= form_with url: user_profile_path(@user), model: @user, method: :put do |form| %>
            <%= form.hidden_field :disabled_at, value: nil %>
            <%= form.submit "Reactivate the account", data: { turbo_confirm: "Are you sure?" }, class: "btn-primary" %>
            <p class="mt-1 text-sm/6 text-fg-muted">Deactivate at: <%= @user.disabled_at %></p>
          <% end %>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <div class="grid grid-cols-1 gap-x-8 gap-y-8 pt-10 md:grid-cols-3">
    <div class="px-4 sm:px-0">
      <h2 class="text-base/7 font-semibold text-fg-default">Log out session</h2>
      <p class="mt-1 text-sm/6 text-fg-muted">No longer want to be logged in?</p>
    </div>

    <div class="flex items-start md:col-span-2">
      <% if @user.current? %>
        <%= button_to session_path, method: :delete, class: "btn-danger" do %>
          <span>Sign out</span>
        <% end %>
      <% else %>
        <p class="text-fg-muted">Your session doesn't belong to <%= @user.email_address %></p>
      <% end %>
    </div>
  </div>

  <% if Current.user.can_administrate? %>
    <div class="grid grid-cols-1 gap-x-8 gap-y-8 pt-10 md:grid-cols-3">
      <div class="px-4 sm:px-0">
        <h2 class="text-base/7 font-semibold text-fg-default">Delete User</h2>
        <p class="mt-1 text-sm/6 text-fg-muted">This action can't be reversed. Their tracked data will remain.</p>
      </div>

      <div class="flex items-start md:col-span-2">
        <% if !@user.current? %>
          <%= button_to(
            user_path(@user),
            method: :delete,
            data: { turbo_confirm: "Are you sure?" },
            class: "btn-danger-solid") do %>
            <span>Yes, Delete user account</span>
          <% end %>
        <% else %>
          <p class="text-fg-muted">Administrators cannot remove their own user.</p>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
