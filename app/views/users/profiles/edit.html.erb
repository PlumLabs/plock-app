<div class="space-y-10 divide-y divide-gray-900/10">
  <div class="grid grid-cols-1 gap-x-8 gap-y-8 md:grid-cols-3">
    <div class="px-4 sm:px-0">
      <h2 class="text-base/7 font-semibold text-gray-900">Personal Information</h2>
      <p class="mt-1 text-sm/6 text-gray-600">Use a permanent address where you can receive mail.</p>
    </div>

    <%= turbo_frame_tag @user, :profile, class: "bg-white shadow-sm ring-1 ring-gray-900/5 sm:rounded-xl md:col-span-2" do %>
      <%= form_with url: user_profile_path(@user), model: @user, method: :put do |form| %>
        <% if @user.errors.present? %>
          <div class="rounded-md bg-red-50 p-4">
            <div class="flex">
              <div class="flex-shrink-0">
                <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16ZM8.28 7.22a.75.75 0 0 0-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 1 0 1.06 1.06L10 11.06l1.72 1.72a.75.75 0 1 0 1.06-1.06L11.06 10l1.72-1.72a.75.75 0 0 0-1.06-1.06L10 8.94 8.28 7.22Z" clip-rule="evenodd" />
                </svg>
              </div>
              <div class="ml-3">
                <h3 class="text-sm font-medium text-red-800">Errors with your submission</h3>
                <div class="mt-2 text-sm text-red-700">
                  <ul role="list" class="list-disc space-y-1 pl-5">
                    <% @user.errors.each do |error| %>
                      <li><%= error.full_message %></li>
                    <% end %>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        <% end %>
        <div class="px-4 py-6 sm:p-8">
          <div class="grid max-w-2xl grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6">
            <div class="sm:col-span-3">
              <label for="first_name" class="block text-sm/6 font-medium text-gray-900">First name</label>
              <div class="mt-2">
                <%= form.text_field :first_name, autocomplete: "given-name", class: "block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm/6" %>
              </div>
            </div>

            <div class="sm:col-span-3">
              <label for="last_name" class="block text-sm/6 font-medium text-gray-900">Last name</label>
              <div class="mt-2">
                <%= form.text_field :last_name, autocomplete: "family-name", class: "block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm/6" %>
              </div>
            </div>

            <div class="sm:col-span-4">
              <label for="email_address" class="block text-sm/6 font-medium text-gray-900">Email address</label>
              <div class="mt-2">
                <%= form.email_field :email_address, autocomplete: "email", disabled: !Current.user.can_administrate?, class: "block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm/6" %>
                <% if !Current.user.can_administrate? %>
                  <p class="mt-2 text-sm text-gray-500">Only Administrator can update this.</p>
                <% end %>
              </div>
            </div>
          </div>
        </div>
        <div class="flex items-center justify-end gap-x-6 border-t border-gray-900/10 px-4 py-4 sm:px-8">
          <% if flash[:notice] %>
            <div data-controller="flash" class="rounded-md">
              <div class="flex">
                <div class="flex-shrink-0">
                  <svg class="h-5 w-5 text-green-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.857-9.809a.75.75 0 0 0-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z" clip-rule="evenodd" />
                  </svg>
                </div>
                <div class="ml-3">
                  <p class="text-sm font-medium text-green-800">Successfully uploaded</p>
                </div>
              </div>
            </div>
          <% end %>
          <button type="button" class="text-sm/6 font-semibold text-gray-900">Cancel</button>
          <button type="submit" class="rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">Save</button>
        </div>
      <% end %>
    <% end %>
  </div>

  <div class="grid grid-cols-1 gap-x-8 gap-y-8 pt-10 md:grid-cols-3">
    <div class="px-4 sm:px-0">
      <h2 class="text-base/7 font-semibold text-gray-900">Change password</h2>
      <p class="mt-1 text-sm/6 text-gray-600">Update your password associated with your account.</p>
    </div>

    <%= turbo_frame_tag @user, :password, class: "bg-white shadow-sm ring-1 ring-gray-900/5 sm:rounded-xl md:col-span-2" do %>
      <%= form_with url: user_profile_path(@user), model: @user, method: :put do |form| %>
        <% if @user.errors.present? %>
          <div class="rounded-md bg-red-50 p-4">
            <div class="flex">
              <div class="flex-shrink-0">
                <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16ZM8.28 7.22a.75.75 0 0 0-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 1 0 1.06 1.06L10 11.06l1.72 1.72a.75.75 0 1 0 1.06-1.06L11.06 10l1.72-1.72a.75.75 0 0 0-1.06-1.06L10 8.94 8.28 7.22Z" clip-rule="evenodd" />
                </svg>
              </div>
              <div class="ml-3">
                <h3 class="text-sm font-medium text-red-800">Errors with your submission</h3>
                <div class="mt-2 text-sm text-red-700">
                  <ul role="list" class="list-disc space-y-1 pl-5">
                    <% @user.errors.each do |error| %>
                      <li><%= error.full_message %></li>
                    <% end %>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        <% end %>

        <div class="px-4 py-6 sm:p-8">
          <div class="grid max-w-2xl grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6">
            <div class="sm:col-span-4">
              <label for="password" class="block text-sm/6 font-medium text-gray-900">New Password</label>
              <div class="mt-2">
                <%= form.password_field :password, required: true, autocomplete: "new-password", placeholder: "Enter new password", maxlength: 72, class: "block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm/6" %>
              </div>
            </div>

            <div class="sm:col-span-4">
              <label for="password_confirmation" class="block text-sm/6 font-medium text-gray-900">Repeat new password</label>
              <div class="mt-2">
                <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", placeholder: "Repeat new password", maxlength: 72, class: "block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm/6" %>
              </div>
            </div>
          </div>
        </div>
        <div class="flex items-center justify-end gap-x-6 border-t border-gray-900/10 px-4 py-4 sm:px-8">
          <% if flash[:notice] %>
            <div data-controller="flash" class="rounded-md">
              <div class="flex">
                <div class="flex-shrink-0">
                  <svg class="h-5 w-5 text-green-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.857-9.809a.75.75 0 0 0-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z" clip-rule="evenodd" />
                  </svg>
                </div>
                <div class="ml-3">
                  <p class="text-sm font-medium text-green-800">Successfully uploaded</p>
                </div>
              </div>
            </div>
          <% end %>
          <button type="button" class="text-sm/6 font-semibold text-gray-900">Cancel</button>
          <%= form.submit "Save", class: "rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600" %>
        </div>
      <% end %>
    <% end %>
  </div>

  <% if Current.user.can_administrate? %>
    <div class="grid grid-cols-1 gap-x-8 gap-y-8 pt-10 md:grid-cols-3">
      <div class="px-4 sm:px-0">
        <h2 class="text-base/7 font-semibold text-gray-900">Change Role</h2>
        <p class="mt-1 text-sm/6 text-gray-600">Administrator role can access everything</p>
      </div>

      <% if @user.current? %>
        <p class="text-gray-500">Administrators cannot change their own role.</p>
      <% else %>
        <%= turbo_frame_tag @user, :role, class: "bg-white shadow-sm ring-1 ring-gray-900/5 sm:rounded-xl md:col-span-2" do %>
          <%= form_with url: user_profile_path(@user), model: @user, method: :put do |form| %>
            <% if @user.errors.present? %>
              <div class="rounded-md bg-red-50 p-4">
                <div class="flex">
                  <div class="flex-shrink-0">
                    <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16ZM8.28 7.22a.75.75 0 0 0-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 1 0 1.06 1.06L10 11.06l1.72 1.72a.75.75 0 1 0 1.06-1.06L11.06 10l1.72-1.72a.75.75 0 0 0-1.06-1.06L10 8.94 8.28 7.22Z" clip-rule="evenodd" />
                    </svg>
                  </div>
                  <div class="ml-3">
                    <h3 class="text-sm font-medium text-red-800">Errors with your submission</h3>
                    <div class="mt-2 text-sm text-red-700">
                      <ul role="list" class="list-disc space-y-1 pl-5">
                        <% @user.errors.each do |error| %>
                          <li><%= error.full_message %></li>
                        <% end %>
                      </ul>
                    </div>
                  </div>
                </div>
              </div>
            <% end %>

            <div class="px-4 py-6 sm:p-8">
              <div class="grid max-w-2xl grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6">
                <div class="sm:col-span-4">
                  <%= form.label :role, class: "block text-sm/6 font-medium text-gray-900" %>
                  <div class="mt-2">
                    <%= form.select :role, User.roles.keys.map { |role| [role.titleize, role] }, {}, class: "block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:max-w-xs sm:text-sm/6" %>
                  </div>
                </div>
              </div>
            </div>
            <div class="flex items-center justify-end gap-x-6 border-t border-gray-900/10 px-4 py-4 sm:px-8">
              <% if flash[:notice] %>
                <div data-controller="flash" class="rounded-md">
                  <div class="flex">
                    <div class="flex-shrink-0">
                      <svg class="h-5 w-5 text-green-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.857-9.809a.75.75 0 0 0-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z" clip-rule="evenodd" />
                      </svg>
                    </div>
                    <div class="ml-3">
                      <p class="text-sm font-medium text-green-800">Successfully uploaded</p>
                    </div>
                  </div>
                </div>
              <% end %>
              <button type="button" class="text-sm/6 font-semibold text-gray-900">Cancel</button>
              <%= form.submit "Save", data: { turbo_confirm: "Are you sure?" }, class: "rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600" %>
            </div>
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <% if Current.user.can_administrate? %>
    <%= turbo_frame_tag @user, :deactivate, class: "grid grid-cols-1 gap-x-8 gap-y-8 pt-10 md:grid-cols-3" do %>
      <div class="px-4 sm:px-0">
        <% if @user.active? %>
          <h2 class="text-base/7 font-semibold text-gray-900">Deactivate User Account</h2>
          <p class="mt-1 text-sm/6 text-gray-600">The user will no longer be able to log in.</p>
        <% else %>
          <h2 class="text-base/7 font-semibold text-gray-900">Reactivate User Account</h2>
          <p class="mt-1 text-sm/6 text-gray-600">The user will be able to log in.</p>
        <% end %>
      </div>

      <div class="flex items-start md:col-span-2">
        <% if @user.current? %>
          <p class="text-gray-500">Administrators cannot Deactivate/Reactivate their own account.</p>
        <% elsif @user.active? %>
          <%= button_to(
            user_profile_path(@user),
            method: :delete,
            data: { turbo_confirm: "Are you sure?" },
            class: "rounded-md bg-red-50 px-3 py-2 text-sm font-semibold text-red-600 shadow-sm hover:bg-red-100") do %>
            <span>Yes, Deactivate the account</span>
          <% end %>
        <% else %>
          <%= form_with url: user_profile_path(@user), model: @user, method: :put do |form| %>
            <%= form.hidden_field :inactive_at, value: nil %>
            <%= form.submit "Reactivate the account", data: { turbo_confirm: "Are you sure?" }, class: "rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline-indigo-600" %>
            <p class="mt-1 text-sm/6 text-gray-600">Deactivate at: <%= @user.inactive_at %></p>
          <% end %>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <div class="grid grid-cols-1 gap-x-8 gap-y-8 pt-10 md:grid-cols-3">
    <div class="px-4 sm:px-0">
      <h2 class="text-base/7 font-semibold text-gray-900">Log out session</h2>
      <p class="mt-1 text-sm/6 text-gray-600">No longer want to be logged in?</p>
    </div>

    <div class="flex items-start md:col-span-2">
      <% if @user.current? %>
        <%= button_to session_path, method: :delete, class: "rounded-md bg-red-50 px-3 py-2 text-sm font-semibold text-red-600 shadow-sm hover:bg-red-100" do %>
          <span>Sign out</span>
        <% end %>
      <% else %>
        <p class="text-gray-500">Your session doesn't belong to <%= @user.email_address %></p>
      <% end %>
    </div>
  </div>

  <% if Current.user.can_administrate? %>
    <div class="grid grid-cols-1 gap-x-8 gap-y-8 pt-10 md:grid-cols-3">
      <div class="px-4 sm:px-0">
        <h2 class="text-base/7 font-semibold text-gray-900">Delete User</h2>
        <p class="mt-1 text-sm/6 text-gray-600">This action can't be reversed. Their tracked data will remain.</p>
      </div>

      <div class="flex items-start md:col-span-2">
        <% if !@user.current? %>
          <%= button_to(
            user_path(@user),
            method: :delete,
            data: { turbo_confirm: "Are you sure?" },
            class: "rounded-md bg-red-500 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-400") do %>
            <span>Yes, Delete user account</span>
          <% end %>
        <% else %>
          <p class="text-gray-500">Administrators cannot remove their own user.</p>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
