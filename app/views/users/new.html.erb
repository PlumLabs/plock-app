<div class="">
  <div class="mb-4 flex items-center">
    <div class="flex-auto">
      <h1 class="text-base font-semibold text-fg-default">New User</h1>
    </div>
  </div>

  <div class="overflow-hidden rounded-lg bg-surface shadow-xs">
    <div class="px-4 py-5 sm:p-6">
      <%= form_with(model: @user) do |form| %>
        <div class="space-y-12">
          <div class="border-b border-border pb-12">

            <%= render "alerts/error_summary", errors: @user.errors.map(&:full_message) if @user.errors.present? %>

            <h2 class="text-base/7 font-semibold text-fg-default">Personal Information</h2>

            <div class="mt-10 grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6">
              <div class="sm:col-span-4">
                <label for="user_first_name" class="form-label">First name</label>
                <div class="mt-2">
                  <%= form.text_field :first_name, required: true, autocomplete: "given-name", class: "form-input" %>
                </div>
              </div>

              <div class="sm:col-span-4">
                <label for="user_last_name" class="form-label">Last name</label>
                <div class="mt-2">
                  <%= form.text_field :last_name, required: true, autocomplete: "family-name", class: "form-input" %>
                </div>
              </div>

              <div class="sm:col-span-4">
                <label for="user_email_address" class="form-label">Email address</label>
                <div class="mt-2">
                  <%= form.email_field :email_address, required: true, autocomplete: "email", class: "form-input" %>
                </div>
              </div>
            </div>
          </div>

          <div class="border-b border-border pb-12">
            <h2 class="text-base/7 font-semibold text-fg-default">User Roles</h2>
            <p class="mt-1 text-sm/6 text-fg-muted">Administrator role can access everything</p>

            <div class="mt-10 grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6">
              <div class="sm:col-span-3">
                <%= form.label :role, class: "form-label" %>
                <div class="mt-2">
                  <%= form.select :role, User.roles.keys.map { |role| [role.titleize, role] }, {}, class: "form-select sm:max-w-xs" %>
                </div>
              </div>
            </div>
          </div>

          <div class="border-b border-border pb-12">
            <h2 class="text-base/7 font-semibold text-fg-default">Password</h2>
            <p class="mt-1 text-sm/6 text-fg-muted">You can reset the user password later</p>

            <div class="mt-10 grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6">
              <div class="sm:col-span-4">
                <label for="user_password" class="form-label">Password</label>
                <div class="mt-2">
                  <%= form.password_field :password, required: true, autocomplete: "new-password", placeholder: "Enter password", maxlength: 72, class: "form-input" %>
                </div>
                <p class="mt-2 text-sm text-fg-muted">Suggestion: <%= SecureRandom.alphanumeric(10)%></p>
              </div>
            </div>
          </div>
        </div>

        <div class="mt-6 flex items-center justify-end gap-x-6">
          <%= link_to "Cancel", users_path, class: "text-sm/6 font-semibold text-fg-default" %>
          <%= form.submit class: "btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
