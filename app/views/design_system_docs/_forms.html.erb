<div class="space-y-6">
  <div>
    <h2 class="text-lg font-semibold text-fg-default">Forms</h2>
    <p class="mt-1 text-sm text-fg-muted">Input building blocks and the form error summary partial.</p>
  </div>

  <%= render layout: "design_system_docs/example", locals: {
    title: "Inputs",
    description: "Label, text input, and select. Focus an input to see the primary focus ring.",
    code: ds_code(:form_inputs)
  } do %>
    <div class="w-full max-w-sm space-y-4">
      <div>
        <label class="form-label" for="ds-name">Name</label>
        <div class="mt-1">
          <input class="form-input" type="text" id="ds-name" placeholder="Acme Inc.">
        </div>
      </div>
      <div>
        <label class="form-label" for="ds-role">Role</label>
        <div class="mt-1">
          <select class="form-select" id="ds-role">
            <option>Admin</option>
            <option>Member</option>
            <option>Viewer</option>
          </select>
        </div>
      </div>
    </div>
  <% end %>

  <%= render layout: "design_system_docs/example", locals: {
    title: "Error summary",
    description: "Renders alerts/_error_summary with a list of messages.",
    code: ds_code(:form_error_summary)
  } do %>
    <div class="w-full max-w-md">
      <%= render "alerts/error_summary", errors: [ "Name can't be blank", "Email is invalid" ] %>
    </div>
  <% end %>
</div>
